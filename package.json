{
  "name": "admin-vue",
  "version": "1.0.0",
  "description": "admin-vue with Element UI & axios & iconfont & permission control & lint",
  "author": "maoyadong1@huawei.com",
  "license": "MIT",
  "scripts": {
    "dev": "vue-cli-service serve",
    "build:prod": "vue-cli-service build",
    "build:dev": "vue-cli-service build --mode development",
    "preview": "node build/index.js --preview",
    "eslint": "eslint --ext .js,.vue src",
    "eslint:fix": "eslint --fix --ext .js,.vue src/",
    "test:unit": "vitest run",
    "test:ci": "npm run eslint && npm run test:unit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "svgo": "svgo -f src/icons/svg --config=src/icons/svgo.yml",
    "new": "plop"
  },
  "dependencies": {
    "axios": "0.18.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.7",
    "file-saver": "2.0.1",
    "js-cookie": "2.2.0",
    "js-sha256": "^0.9.0",
    "lodash": "^4.17.21",
    "normalize.css": "7.0.0",
    "nprogress": "0.2.0",
    "path-to-regexp": "2.4.0",
    "screenfull": "4.2.0",
    "vue": "2.6.10",
    "vue-grid-layout": "^2.4.0",
    "vue-i18n": "^8.25.0",
    "vue-json-editor": "^1.4.3",
    "vue-json-viewer": "^2.2.22",
    "vue-router": "3.0.6",
    "vue-splitpane": "1.0.4",
    "vuedraggable": "^2.24.3",
    "vuex": "3.1.0",
    "xlsx": "0.14.1"
  },
  "devDependencies": {
    "@babel/core": "7.0.0",
    "@babel/plugin-proposal-optional-chaining": "^7.14.5",
    "@babel/plugin-transform-modules-commonjs": "^7.15.0",
    "@babel/register": "7.0.0",
    "@vue/cli-plugin-babel": "3.6.0",
    "@vue/cli-plugin-eslint": "^3.9.1",
    "@vue/cli-service": "3.6.0",
    "@vue/test-utils": "^1.3.6",
    "autoprefixer": "^9.5.1",
    "babel-core": "7.0.0-bridge.0",
    "babel-eslint": "10.0.1",
    "chalk": "2.4.2",
    "connect": "3.6.6",
    "element-ui": "^2.7.0",
    "eslint": "5.15.3",
    "eslint-plugin-vue": "5.2.2",
    "html-webpack-plugin": "3.2.0",
    "mockjs": "1.0.1-beta3",
    "plop": "2.3.0",
    "runjs": "^4.3.2",
    "sass": "^1.26.8",
    "sass-loader": "^7.3.1",
    "script-ext-html-webpack-plugin": "2.1.3",
    "script-loader": "0.7.2",
    "serve-static": "^1.13.2",
    "svg-sprite-loader": "4.1.3",
    "svgo": "1.2.2",
    "v-easy-components": "^1.2.4",
    "vue-template-compiler": "2.6.10",
    "webpack": "^4.41.2",
    "vitest": "^2.1.8",
    "happy-dom": "^15.11.7",
    "@vitest/coverage-v8": "^2.1.8",
    "vite": "^5.4.10"
  },
  "engines": {
    "node": ">=16",
    "npm": ">=8"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
