r\" tabindex=\"-1\"><!-- prefix slot --><!--v-if--><input class=\"el-input__inner\" type=\"text\" autocomplete=\"off\" tabindex=\"0\" placeholder=\"输入任务名称\" aria-required=\"true\" id=\"el-id-1024-12\"><!-- suffix slot --><span class=\"el-input__suffix\"><span class=\"el-input__suffix-inner\"><i class=\"el-icon el-input__icon el-input__clear\" style=\"visibility: hidden;\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1024 1024\"><path fill=\"currentColor\" d=\"m466.752 512-90.496-90.496a32 32 0 0 1 45.248-45.248L512 466.752l90.496-90.496a32 32 0 1 1 45.248 45.248L557.248 512l90.496 90.496a32 32 0 1 1-45.248 45.248L512 557.248l-90.496 90.496a32 32 0 0 1-45.248-45.248z\"></path><path fill=\"currentColor\" d=\"M512 896a384 384 0 1 0 0-768 384 384 0 0 0 0 768m0 64a448 448 0 1 1 0-896 448 448 0 0 1 0 896\"></path></svg></i><!--v-if--><!--v-if--><!--v-if--><!--v-if--></span></span></div><!-- append slot --><!--v-if--></div></div></div><div class=\"el-form-item asterisk-left el-form-item--label-top lx-form-item lx-dynamic-form__item lx-dynamic-form__item\" style=\"--lx-dynamic-form-span-3: 2; --lx-dynamic-form-span-2: 1;\"><label id=\"el-id-1024-1\" for=\"el-id-1024-13\" class=\"el-form-item__label\">任务类型</label><div class=\"el-form-ite"
