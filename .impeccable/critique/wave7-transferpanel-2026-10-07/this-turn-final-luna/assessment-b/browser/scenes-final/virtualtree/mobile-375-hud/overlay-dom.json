    "outerHTML": "<div class=\"impeccable-overlay impeccable-banner\" style=\"position: fixed; top: 0px; left: 0px; right: 0px; z-index: 100000; background: oklch(0.84 0.19 80.46); color: oklch(0.04 0.004 95); font-family: system-ui, sans-serif; font-size: 13px; display: flex; align-items: center; pointer-events: auto; height: 36px; overflow: hidden; max-width: 100vw; transform: translateY(0px); transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);\"><div style=\"flex: 1 1 0%; min-width: 0px; overflow: auto hidden; display: flex; gap: 8px; align-items: center; padding: 0px 12px; scroll-snap-type: x mandatory; scrollbar-width: none;\"><span style=\"background: rgba(255, 255, 255, 0.15); padding: 2px 8px; border-radius: 3px; font-size: 12px; font-family: ui-monospace, monospace; white-space: nowrap; flex-shrink: 0; scroll-snap-align: start;\">layout property animation: transition: height, padding-top, padding-bottom</span></div><div style=\"display: flex; align-items: center; gap: 2px; padding: 0px 8px; flex-shrink: 0;\"><button title=\"Toggle overlay visibility\" style=\"background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: white; font-size: 16px; cursor: pointer; padding: 0px 4px; opacity: 0.85; transition: opacity 0.15s;\">◉</button><button title=\"Dismiss banner\" style=\"background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: white; font-size: 18px; cursor: pointer; padding: 0px 4px;\">×</button></div></div>",
