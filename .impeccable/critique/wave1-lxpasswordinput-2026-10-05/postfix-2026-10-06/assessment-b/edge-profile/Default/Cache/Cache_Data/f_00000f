const __vite__css = "/**\n * lx-tokens → Element Plus 变量桥接层\n * 说明：\n *  - 选择器用 html:root（特异性 0,1,1）压过 EP 的 :root（0,1,0），与加载顺序无关\n *  - HUD 深色：EP dark 变量在 html.dark（0,1,1），本文件用 html.dark.lx-theme-hud（0,2,1）覆盖\n *  - 业务侧只需引入本包入口（自动加载），EP 组件即套用 LxUI 设计令牌\n */\nhtml:root {\n  /* 主色 #0060a9 及其明暗梯度（EP light-N = 与白混合 N*10%） */\n  --el-color-primary: var(--lx-color-primary);\n  --el-color-primary-light-3: #4d90c3;\n  --el-color-primary-light-5: #80b0d4;\n  --el-color-primary-light-7: #b3cfe5;\n  --el-color-primary-light-8: #ccdfed;\n  --el-color-primary-light-9: var(--lx-color-primary-light);\n  --el-color-primary-dark-2: #004d87;\n\n  /* 功能语义色与 LxUI 对齐（EP 默认值相同，显式声明兜底） */\n  --el-color-success: var(--lx-color-success);\n  --el-color-warning: var(--lx-color-warning);\n  --el-color-danger: var(--lx-color-error);\n  --el-color-error: var(--lx-color-error);\n  --el-color-info: var(--lx-color-info);\n\n  /* 表面/边框/文字 */\n  --el-bg-color: var(--lx-bg-card);\n  --el-bg-color-overlay: var(--lx-bg-card);\n  --el-fill-color-blank: var(--lx-bg-card);\n  --el-fill-color-light: var(--lx-bg-card-hover);\n  --el-fill-color-lighter: var(--lx-bg-table-header);\n  --el-border-color: var(--lx-border);\n  --el-border-color-light: var(--lx-border-light);\n  --el-border-color-lighter: var(--lx-border-light);\n  --el-text-color-primary: var(--lx-text-primary);\n  --el-text-color-regular: var(--lx-text-regular);\n  --el-text-color-secondary: var(--lx-text-secondary);\n  --el-text-color-placeholder: var(--lx-text-placeholder);\n\n  /* 字体与圆角 */\n  --el-font-family: var(--lx-font-family);\n  --el-border-radius-base: var(--lx-radius-md);\n  --el-border-radius-small: var(--lx-radius-sm);\n  --el-font-size-base: 13px;\n  --el-component-size: var(--lx-control-height);\n  --el-component-size-small: var(--lx-control-height-sm);\n  --el-component-size-large: var(--lx-control-height-lg);\n}\n\n/* ===== 高频 Element Plus 控件桥接 =====\n * 仅收敛视觉令牌，不改变组件的事件、校验和数据行为。\n */\n.el-button {\n  min-height: var(--el-component-size);\n  border-radius: var(--lx-radius-md);\n  font-size: 13px;\n  font-weight: 500;\n  transition:\n    color var(--lx-transition),\n    background-color var(--lx-transition),\n    border-color var(--lx-transition);\n}\n\n.el-button--small {\n  min-height: var(--lx-control-height-sm);\n}\n\n.el-button--large {\n  min-height: var(--lx-control-height-lg);\n  font-size: 14px;\n  font-weight: 600;\n}\n\n.el-button.el-button--primary:not(.is-link):not(.is-text):not(.is-plain) {\n  --el-button-bg-color: var(--lx-color-primary);\n  --el-button-border-color: var(--lx-color-primary);\n  --el-button-hover-bg-color: var(--lx-color-primary-hover);\n  --el-button-hover-border-color: var(--lx-color-primary-hover);\n  --el-button-active-bg-color: var(--lx-color-primary-active);\n  --el-button-active-border-color: var(--lx-color-primary-active);\n  --el-button-text-color: var(--lx-color-on-primary);\n  --el-button-hover-text-color: var(--lx-color-on-primary);\n  --el-button-active-text-color: var(--lx-color-on-primary);\n}\n\n.el-button--default,\n.el-button:not(.el-button--primary):not(.el-button--success):not(\n    .el-button--warning\n  ):not(.el-button--danger):not(.el-button--info):not(.is-text):not(.is-link) {\n  --el-button-bg-color: var(--lx-bg-card);\n  --el-button-border-color: var(--lx-border);\n  --el-button-text-color: var(--lx-text-regular);\n  --el-button-hover-bg-color: var(--lx-color-primary-light);\n  --el-button-hover-border-color: var(--lx-color-primary);\n  --el-button-hover-text-color: var(--lx-color-primary);\n}\n\n.el-button.el-button--danger:not(.is-link):not(.is-text):not(.is-plain) {\n  --el-button-bg-color: var(--lx-color-error);\n  --el-button-border-color: var(--lx-color-error);\n  --el-button-hover-bg-color: var(--lx-color-danger-hover);\n  --el-button-hover-border-color: var(--lx-color-danger-hover);\n  --el-button-active-bg-color: var(--lx-color-danger-hover);\n  --el-button-active-border-color: var(--lx-color-danger-hover);\n  --el-button-text-color: var(--lx-color-on-danger);\n  --el-button-hover-text-color: var(--lx-color-on-danger);\n  --el-button-active-text-color: var(--lx-color-on-danger);\n}\n\n.el-button--danger.is-link,\n.el-button--danger.is-text {\n  --el-button-text-color: var(--lx-color-error-strong);\n  --el-button-hover-text-color: var(--lx-color-error-strong);\n  --el-button-active-text-color: var(--lx-color-error-strong);\n  --el-button-disabled-text-color: var(--lx-color-error-strong);\n}\n\n.el-button.is-link,\n.el-button.is-text {\n  min-height: var(--lx-control-height);\n  padding-inline: var(--lx-space-sm);\n  border-radius: var(--lx-radius-md);\n}\n\n.el-button:focus-visible,\n.el-switch:focus-visible .el-switch__core {\n  outline: 2px solid var(--lx-color-primary);\n  outline-offset: 2px;\n}\n\n.el-button.is-disabled,\n.el-button.is-disabled:hover,\n.el-input.is-disabled .el-input__wrapper,\n.el-select__wrapper.is-disabled {\n  opacity: 0.6;\n}\n\n.el-input__wrapper,\n.el-select__wrapper,\n.el-textarea__inner {\n  border-radius: var(--lx-radius-md);\n  box-shadow: 0 0 0 1px var(--lx-control-border) inset;\n  transition:\n    box-shadow var(--lx-transition),\n    background-color var(--lx-transition);\n}\n\n/* 选择器用真实 1px 边框承载状态色，边线贴合控件几何外缘。 */\nhtml:root .el-select__wrapper {\n  box-sizing: border-box;\n  border: 1px solid var(--lx-control-border);\n  padding: 3px 11px;\n  box-shadow: none;\n  transition:\n    border-color var(--lx-transition),\n    background-color var(--lx-transition),\n    box-shadow var(--lx-transition);\n}\n\n.el-input__wrapper:hover,\n.el-textarea__inner:hover {\n  box-shadow: 0 0 0 1px var(--lx-color-primary) inset;\n}\n\nhtml:root .el-select__wrapper:hover {\n  border-color: var(--lx-color-primary);\n  box-shadow: none;\n}\n\n/* 部分 EP 组件样式晚于桥接层注入；根选择器提高优先级以稳定应用焦点令牌。 */\nhtml:root .el-input__wrapper.is-focus,\nhtml:root .el-date-editor.is-active,\nhtml:root .el-textarea__inner:focus {\n  outline: none;\n  outline-offset: 0;\n  box-shadow:\n    0 0 0 1px var(--lx-color-primary) inset,\n    0 0 0 2px var(--lx-control-focus-halo-color);\n}\n\n/* 单选和多选都只用自身边框提示焦点，避免控件外再出现第二圈。 */\nhtml:root .el-select__wrapper.is-focused {\n  border-color: var(--lx-color-primary);\n  box-shadow: none;\n  outline: none;\n  outline-offset: 0;\n}\n\n.el-form-item.is-error .el-input__wrapper,\n.el-form-item.is-error .el-textarea__inner {\n  background-color: var(--lx-color-form-error-bg);\n  box-shadow: 0 0 0 1px var(--lx-color-form-error) inset;\n}\n\nhtml:root .el-form-item.is-error .el-input__wrapper.is-focus,\nhtml:root .el-form-item.is-error .el-date-editor.is-active,\nhtml:root .el-form-item.is-error .el-textarea__inner:focus {\n  outline: none;\n  outline-offset: 0;\n  box-shadow:\n    0 0 0 1px var(--lx-color-form-error) inset,\n    0 0 0 2px var(--lx-control-focus-halo-color);\n}\n\nhtml:root .el-form-item.is-error .el-select__wrapper {\n  background-color: var(--lx-color-form-error-bg);\n  border-color: var(--lx-color-form-error);\n  box-shadow: none;\n}\n\nhtml:root .el-form-item.is-error .el-select__wrapper.is-focused {\n  border-color: var(--lx-color-form-error);\n  box-shadow: none;\n}\n\n.el-form-item.is-error .el-form-item__error {\n  color: var(--lx-color-form-error);\n}\n\n/* 字段校验错误的输入值与边线使用同一表单专属令牌。 */\n.el-form-item.is-error .el-input__inner,\n.el-form-item.is-error .el-textarea__inner,\n.el-form-item.is-error .el-range-input {\n  color: var(--lx-color-form-error);\n}\n\n.el-textarea__inner {\n  resize: vertical;\n}\n\n/* ===== Popper 终态（design/表单控件八件套 02/06）=====\n * 加 html:root 提特异性：EP 2.14 的 .el-xxx__popper.el-popper 为 (0,2,0)，\n * 原桥接层 (0,1,0) 实际从未生效，本波一并修复。\n */\nhtml:root .el-select__popper,\nhtml:root .el-picker__popper,\nhtml:root .el-dropdown__popper,\nhtml:root .el-popover.el-popper {\n  border-radius: var(--lx-radius-md);\n  box-shadow: var(--lx-shadow-pop);\n}\n\n/* ===== Tooltip / Popover / Dropdown 桥接（浮层三件套） =====\n * 统一 Teleport 到 body 后的层级、圆角、阴影和焦点可见性。组件仍保留\n * Element Plus 的键盘导航、定位和关闭契约；业务只需使用对应 EP 控件。\n */\nhtml:root .el-tooltip__popper.el-popper,\nhtml:root .el-popper.is-dark {\n  --el-popper-bg-color-dark: var(--lx-bg-inverse);\n  z-index: 4000;\n  border: 1px solid var(--lx-bg-inverse);\n  border-radius: var(--lx-radius-md);\n  background: var(--lx-bg-inverse);\n  box-shadow: var(--lx-shadow-pop);\n  color: var(--lx-text-inverse);\n  font-size: 12px;\n  line-height: 20px;\n}\n\nhtml:root .el-tooltip__popper.el-popper > .el-popper__arrow:before,\nhtml:root .el-popper.is-dark > .el-popper__arrow:before {\n  border-color: var(--lx-bg-inverse);\n  background: var(--lx-bg-inverse);\n}\n\nhtml:root .el-popover.el-popper {\n  --el-popover-bg-color: var(--lx-bg-card);\n  --el-popover-border-color: var(--lx-border);\n  --el-popover-padding: var(--lx-space-md);\n  --el-popover-border-radius: var(--lx-radius-md);\n  z-index: 2000;\n  color: var(--lx-text-regular);\n  box-shadow: var(--lx-shadow-pop);\n}\n\nhtml:root .el-dropdown__popper.el-popper {\n  --el-dropdown-menu-box-shadow: var(--lx-shadow-pop);\n  --el-dropdown-menuItem-hover-fill: var(--lx-bg-table-header);\n  --el-dropdown-menuItem-hover-color: var(--lx-color-primary);\n  --el-dropdown-menu-index: 2000;\n  z-index: 2000;\n  border-radius: var(--lx-radius-md);\n  box-shadow: var(--lx-shadow-pop);\n}\n\nhtml:root .el-dropdown-menu {\n  min-width: 128px;\n  padding: var(--lx-space-xs) 0;\n  background: var(--lx-bg-card);\n}\n\nhtml:root .el-dropdown-menu__item {\n  min-height: var(--lx-control-height);\n  box-sizing: border-box;\n  padding: var(--lx-space-xs) var(--lx-space-lg);\n  color: var(--lx-text-regular);\n  font-size: 13px;\n  line-height: 24px;\n}\n\nhtml:root .el-dropdown-menu__item:not(.is-disabled):hover,\nhtml:root .el-dropdown-menu__item:not(.is-disabled):focus {\n  background: var(--lx-bg-table-header);\n  color: var(--lx-color-primary);\n}\n\nhtml:root .el-dropdown-menu__item--divided {\n  margin: var(--lx-space-xs) 0;\n  border-top-color: var(--lx-border-light);\n}\n\nhtml:root .el-dropdown-menu__item.is-disabled {\n  color: var(--lx-text-placeholder);\n  cursor: not-allowed;\n}\n\nhtml:root .el-dropdown-menu__item.is-danger,\nhtml:root .el-dropdown-menu__item--danger {\n  color: var(--lx-color-error-strong);\n}\n\nhtml:root .el-dropdown-menu__item.is-danger:not(.is-disabled):hover,\nhtml:root .el-dropdown-menu__item--danger:not(.is-disabled):hover {\n  background: var(--lx-color-error-light);\n  color: var(--lx-color-error-strong);\n}\n\nhtml:root .el-dropdown-selfdefine:focus-visible,\nhtml:root .el-popover__reference:focus-visible {\n  outline: 2px solid var(--lx-color-primary);\n  outline-offset: 2px;\n}\n\n/* ===== Select 下拉面板终态（design/表单控件八件套 02，EP 2.14.6 类名锚定）=====\n * 标本契约：选项行高 32px；选中项 #f5f7fa 底 + 主色文字 + 500 字重 + 右侧 Check（EP 原生）。\n * 展开态箭头旋转 180° 由 EP 原生 .el-select__caret.is-reverse 提供，无需覆写。\n */\nhtml:root .el-select-dropdown__item {\n  height: 32px;\n  line-height: 32px;\n}\n\nhtml:root .el-select-dropdown__item.is-selected {\n  color: var(--lx-color-primary);\n  font-weight: 500;\n  background-color: var(--lx-bg-table-header);\n}\n\n/* 展开态触发器：已选文字转主色。\n * :not(.is-transparent) 排除空值占位态，避免误染 placeholder。\n */\nhtml:root\n  .el-select__wrapper.is-focused\n  .el-select__placeholder:not(.is-transparent) {\n  color: var(--lx-color-primary);\n  font-weight: 500;\n}\n\n/* ===== 日期区间带（design/表单控件八件套 06）=====\n * 连贯区间浅蓝带 #ecf5ff；起止主色圆点白字由 EP 默认提供。\n * EP 2.14.6 变量锚定：--el-datepicker-inrange(-hover)-bg-color。\n */\nhtml:root {\n  --el-datepicker-inrange-bg-color: var(--lx-color-primary-light);\n  --el-datepicker-inrange-hover-bg-color: var(--lx-color-primary-light);\n}\n\n/* 数值与日期输入用等宽字体（标本八件套 05/06 font-mono 契约），不做全局 mono */\nhtml:root .el-input-number .el-input__inner,\nhtml:root .el-date-editor .el-input__inner,\nhtml:root .el-date-editor .el-range-input {\n  font-family: var(--lx-font-mono);\n}\n\n/* ===== 单选/复选终态（design/表单控件八件套 03/04，EP 2.14.6 类名锚定）=====\n * 标本契约：选项文字 12px；未选描边 #dcdfe6；\n * 单选选中为\"白底蓝心靶环\"（非 EP 默认整圆填充），靶心 6px；\n * hover 时描边与文字同步提亮到主色。\n */\n.el-radio,\n.el-checkbox {\n  min-height: var(--lx-control-height);\n  font-size: 12px;\n}\n\n/* 未选态描边：#dcdfe6 深于容器外框一档（--lx-control-border 专属控件态） */\nhtml:root .el-radio__inner,\nhtml:root .el-checkbox__inner {\n  border-color: var(--lx-control-border);\n}\n\n/* hover：描边与 label 同步转主色（标本 03/04 group-hover 契约），禁用态除外 */\nhtml:root .el-radio:not(.is-disabled):hover .el-radio__inner,\nhtml:root .el-checkbox:not(.is-disabled):hover .el-checkbox__inner {\n  border-color: var(--lx-color-primary);\n}\n\n.el-radio:not(.is-disabled):hover .el-radio__label,\n.el-checkbox:not(.is-disabled):hover .el-checkbox__label {\n  color: var(--lx-color-primary);\n}\n\n/* 单选选中态：白底 + 主色描边 + 6px 主色靶心（标本八件套 03）。\n * :not(.is-disabled) 保证 EP 的灰底禁用态优先级不被本规则覆盖。\n * ::after 尺寸/颜色覆写 EP 默认（4px 白心），缩放动画由 EP 原生 scale 提供。\n */\nhtml:root .el-radio__input.is-checked:not(.is-disabled) .el-radio__inner {\n  border-color: var(--lx-color-primary);\n  background: var(--lx-bg-card);\n}\n\nhtml:root .el-radio__input.is-checked:not(.is-disabled) .el-radio__inner:after {\n  width: 6px;\n  height: 6px;\n  background-color: var(--lx-color-primary);\n}\n\n/* 选中态 label：主色 + 500 字重（标本八件套 03）。\n * :not(.is-disabled) 防止 500 字重泄漏进禁用态（EP 禁用灰只覆盖 color）。\n */\n.el-radio__input.is-checked:not(.is-disabled) + .el-radio__label {\n  color: var(--lx-color-primary);\n  font-weight: 500;\n}\n\n/* 复选选中/半选：主色填充 + 白勾/横杠；禁用态保留灰色表面 */\n.el-checkbox__input.is-checked:not(.is-disabled) .el-checkbox__inner,\n.el-checkbox__input.is-indeterminate:not(.is-disabled) .el-checkbox__inner {\n  border-color: var(--lx-color-primary);\n  background: var(--lx-color-primary);\n}\n\n.el-checkbox__input.is-checked:not(.is-disabled) + .el-checkbox__label {\n  color: var(--lx-color-text-main);\n}\n\n.el-checkbox:not(.is-disabled):hover\n  .el-checkbox__input.is-checked\n  + .el-checkbox__label {\n  color: var(--lx-color-primary);\n}\n\n/* 表单字段标签：#606266（标本八件套统一 label 契约，弱于正文保证层级） */\nhtml:root .el-form-item__label {\n  color: var(--lx-text-label);\n}\n\n/* EP 2.14.6 的 radio is-focus 类挂在根 label 上（非 __input），\n * 焦点环走原生 input:focus-visible + 相邻 inner 钩子（仅键盘导航显示） */\n.el-radio__original:focus-visible + .el-radio__inner {\n  outline: 2px solid var(--lx-color-primary);\n  outline-offset: 2px;\n}\n\nhtml:root .el-checkbox__input.is-focus .el-checkbox__inner {\n  box-sizing: border-box;\n  border-color: var(--el-color-primary);\n  outline: none;\n  outline-offset: 0;\n  box-shadow: 0 0 0 2px var(--lx-control-focus-halo-color);\n}\n\nhtml.dark.lx-theme-hud\n  .el-checkbox__input:not(.is-checked):not(.is-indeterminate):not(\n    .is-disabled\n  ):not(.is-focus)\n  .el-checkbox__inner {\n  border-color: var(--el-text-color-regular);\n  background-color: var(--el-bg-color);\n}\n\n.el-switch {\n  --el-switch-on-color: var(--lx-color-success);\n  --el-switch-off-color: var(--lx-color-info);\n}\n\n.el-card {\n  --el-card-border-color: var(--lx-border);\n  border-radius: var(--lx-radius-md);\n  box-shadow: var(--lx-shadow-card);\n}\n\n.el-tabs {\n  --el-tabs-header-height: var(--lx-tabsbar-height);\n}\n\n.el-tabs__item {\n  color: var(--lx-text-regular);\n  font-size: 13px;\n}\n\n.el-tabs__item.is-active,\n.el-tabs__item:hover {\n  color: var(--lx-color-primary);\n}\n\n.el-tabs__active-bar {\n  background-color: var(--lx-color-primary);\n}\n\n.el-tree {\n  --el-tree-node-hover-bg-color: var(--lx-bg-card-hover);\n  --el-tree-text-color: var(--lx-text-regular);\n  background: transparent;\n  color: var(--lx-text-regular);\n}\n\n.el-tree-node__content {\n  min-height: var(--lx-tree-item-height);\n}\n\n.el-tree-node:focus > .el-tree-node__content,\n.el-tree-node.is-current > .el-tree-node__content {\n  background: var(--lx-color-primary-light);\n  color: var(--lx-color-primary);\n}\n\n.el-descriptions__label.el-descriptions__cell,\n.el-descriptions__content.el-descriptions__cell {\n  font-size: 13px;\n  line-height: 20px;\n}\n\n.el-descriptions__label.el-descriptions__cell {\n  color: var(--lx-text-secondary);\n}\n\n.el-descriptions__content.el-descriptions__cell {\n  color: var(--lx-text-primary);\n}\n\n.el-upload-dragger {\n  border-radius: var(--lx-radius-lg);\n  border-color: var(--lx-border);\n  background: var(--lx-bg-card);\n}\n\n/* 全局 HUD 主题挂在 html；传送菜单也可通过自身的 HUD 类独立应用主题令牌。 */\nhtml.dark.lx-theme-hud,\nhtml:root .el-picker__popper.lx-theme-hud,\nhtml:root .lx-select__popper.lx-theme-hud {\n  --el-bg-color: #0b1220;\n  --el-bg-color-overlay: #16233a;\n  --el-fill-color-blank: #101a2c;\n  --el-fill-color-light: #16233a;\n  --el-fill-color-lighter: #0d1526;\n  --el-border-color: #1e2f47;\n  --el-border-color-light: #1a2a40;\n  --el-border-color-lighter: #1a2a40;\n  --el-text-color-primary: #e2e8f0;\n  --el-text-color-regular: #94a3b8;\n  --el-text-color-secondary: #64748b;\n  --el-text-color-placeholder: var(--lx-text-placeholder);\n\n  /* 主色偏移为战术蓝 sky */\n  --el-color-primary: #38bdf8;\n  --el-color-primary-light-3: #74d1fa;\n  --el-color-primary-light-5: #9cdefc;\n  --el-color-primary-light-7: #c3ebfd;\n  --el-color-primary-light-8: #d7f2fe;\n  --el-color-primary-light-9: rgba(56, 189, 248, 0.12);\n  --el-color-primary-dark-2: #2d97c6;\n  --el-color-on-primary: #0b1220;\n  --lx-color-error-strong: #f78989;\n\n  /* 表单控件暗色适配：标签与描边跟随 HUD 表面体系，\n   * #606266/#dcdfe6 是亮色值，深底上直接不可见 */\n  --lx-text-label: var(--el-text-color-regular);\n  --lx-control-border: var(--el-border-color);\n\n  /* 按钮专属令牌 HUD 偏移：主操作换战术蓝 sky，实底文字随 EP on-primary 变深 */\n  --lx-btn-primary-bg: var(--el-color-primary);\n  --lx-btn-primary-hover: var(--el-color-primary-light-3);\n  --lx-btn-primary-active: var(--el-color-primary-dark-2);\n  --lx-btn-ring: 0 0 0 2px rgba(56, 189, 248, 0.25);\n  /* 次按钮/文字形态禁用色偏移：亮色 #f5f7fa/#ebeef5/#c0c4cc 深底不可见，\n   * 换 HUD 表面/边框/占位色阶 */\n  --lx-btn-disabled-bg: var(--el-fill-color-light);\n  --lx-btn-disabled-border: var(--el-border-color);\n  --lx-btn-disabled-text: var(--el-text-color-placeholder);\n}\n\n/* 传送下拉只在自身范围覆盖 Lx 主色，避免影响页面其他组件。 */\nhtml:root .lx-select__popper.lx-theme-hud {\n  --lx-color-primary: #38bdf8;\n}\n\n/* HUD 选中项底色：#f5f7fa 是亮色值，深底换成 EP HUD 表面色 */\nhtml.dark.lx-theme-hud .el-select-dropdown__item.is-selected,\nhtml:root\n  .lx-select__popper.lx-theme-hud\n  .el-select-dropdown__item.is-selected {\n  background-color: var(--el-fill-color-light);\n}\n\n/* HUD 单选靶心：深底替代白底，描边与靶心跟随 HUD 主色 sky\n * （--lx-color-primary 仍是亮色深蓝 #0060a9，深底上对比度不足） */\nhtml.dark.lx-theme-hud\n  .el-radio__input.is-checked:not(.is-disabled)\n  .el-radio__inner {\n  border-color: var(--el-color-primary);\n  background: var(--el-bg-color-overlay);\n}\n\nhtml.dark.lx-theme-hud\n  .el-radio__input.is-checked:not(.is-disabled)\n  .el-radio__inner:after {\n  background-color: var(--el-color-primary);\n}\n\n/* HUD 下未选圆环沿用深色表面，禁用态则保留可辨认的中性灰阶。 */\nhtml.dark.lx-theme-hud\n  .el-radio__input:not(.is-checked):not(.is-disabled)\n  .el-radio__inner {\n  border-color: var(--el-text-color-regular);\n  background: var(--el-bg-color);\n}\n\nhtml.dark.lx-theme-hud .el-radio__input.is-disabled .el-radio__inner,\nhtml.dark.lx-theme-hud .el-checkbox__input.is-disabled .el-checkbox__inner {\n  border-color: var(--el-text-color-regular);\n  background: var(--el-fill-color-light);\n}\n\nhtml.dark.lx-theme-hud .el-radio__input.is-disabled + .el-radio__label,\nhtml.dark.lx-theme-hud .el-checkbox__input.is-disabled + .el-checkbox__label {\n  color: var(--el-text-color-regular);\n}\n\n/* HUD 复选填充：同上跟随 HUD 主色，避免亮色深蓝填块在深底发闷 */\nhtml.dark.lx-theme-hud\n  .el-checkbox__input.is-checked:not(.is-disabled)\n  .el-checkbox__inner,\nhtml.dark.lx-theme-hud\n  .el-checkbox__input.is-indeterminate:not(.is-disabled)\n  .el-checkbox__inner {\n  border-color: var(--el-color-primary);\n  background: var(--el-color-primary);\n}\n"
