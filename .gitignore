# 本地校验缓存与 TypeScript 增量编译记录，不属于源码
.eslintcache
.stylelintcache
.prettiercache
*.tsbuildinfo

# 本机环境覆盖配置；保留仓库已有的共享环境配置与示例
.env.local
.env.*.local

# 本地包管理缓存，不纳入仓库
.pnpm-store/

# Impeccable 本机审查缓存与历史快照不纳入仓库，正式结论同步记录在项目文档
.impeccable/
# Impeccable 临时 detector、stderr、截图和浏览器证据文件
.impeccable-*

# 根目录 VitePress 本地预构建缓存
/docs/.vitepress/cache/
/docs/.vitepress/.temp/

# Editor directories and files
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.vscode/
*.codex/

dist.*

# 自动化验收的本地运行产物；正式测试源码和中文结论继续纳入仓库
test-results/
playwright-report/
/chrome-tmp/
