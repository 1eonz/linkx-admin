{
  "name": "lx-ui",
  "version": "0.1.0",
  "description": "LinkX 业务组件库：本地文档站（pnpm dev）+ 可打包依赖（pnpm build），Vue3 + Element Plus 二次封装",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "main": "./dist/lx-ui.js",
    "module": "./dist/lx-ui.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/lx-ui.js"
      },
      "./dist/*": "./dist/*"
    }
  },
  "files": ["src", "dist"],
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vite build",
    "build:docs": "vitepress build docs",
    "preview:docs": "vitepress preview docs",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "element-plus": "^2.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "vue-demi"]
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "element-plus": "^2.9.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^3.3.1",
    "vitepress": "^1.4.0",
    "vue": "^3.5.12",
    "vue-tsc": "^2.1.10"
  }
}
