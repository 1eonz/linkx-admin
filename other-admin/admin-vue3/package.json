{
  "name": "linkx-admin-vue3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Linkx Admin 后台管理系统（Vue3 重构版）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:prod": "vue-tsc --noEmit && vite build --mode production",
    "preview": "vite preview",
    "lint:ts": "vue-tsc --noEmit",
    "lint:eslint": "eslint \"src/**/*.{vue,ts,tsx}\" --cache --fix",
    "lint:prettier": "prettier \"src/**/*.{js,json,tsx,css,less,vue,html,md}\" --write --cache --log-level warn",
    "lint:stylelint": "stylelint \"src/**/*.{vue,css,less}\" --fix",
    "lint:lint-staged": "lint-staged"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^11.1.0",
    "axios": "^1.7.7",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "element-plus": "^2.9.5",
    "js-cookie": "^3.0.1",
    "lodash-es": "^4.17.21",
    "nprogress": "^0.2.0",
    "path-to-regexp": "^6.2.1",
    "pinia": "^2.2.5",
    "qs": "^6.11.2",
    "vue": "^3.5.12",
    "vue-i18n": "^10.0.4",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/crypto-js": "^4.2.1",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash-es": "^4.17.6",
    "@types/node": "^22.8.4",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.9.7",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "autoprefixer": "^10.4.7",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^9.27.0",
    "less": "^4.2.0",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "stylelint": "^16.0.0",
    "stylelint-config-prettier": "^9.0.4",
    "stylelint-config-recess-order": "^5.0.1",
    "typescript": "^5.6.3",
    "unplugin-auto-import": "^0.18.3",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^5.4.10",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
